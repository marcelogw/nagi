{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-write.mjs",
            "timeout": 10,
            "statusMessage": "Checking the write against the project rules"
          }
        ]
      }
    ]
  }
}
